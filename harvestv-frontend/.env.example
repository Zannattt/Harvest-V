# Optional absolute writable directory for local SQLite storage.
# Default: ../.harvestv-data (outside the frontend source directory).
# HARVESTV_DATA_DIR=C:/path/to/harvestv-data

# Required on Vercel: connect a managed PostgreSQL database and set its pooled connection string.
# Local development keeps using SQLite when this variable is unset.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
